# Font
font-family = "Fira Code"
font-style = Regular
font-thicken = true
font-size = 12

# Theme
theme = Xcode Dark hc
background = #000000

# Cursor styling
cursor-style = block

# Window
window-theme = ghostty
window-decoration = auto
window-padding-x = 4,4
window-padding-y = 4,1

confirm-close-surface=false
quit-after-last-window-closed = true

macos-titlebar-style = hidden
macos-titlebar-proxy-icon = hidden
macos-window-buttons = hidden
gtk-toolbar-style = flat

macos-icon = custom-style
macos-icon-frame = plastic
macos-icon-ghost-color = #f3dd70
macos-icon-screen-color = #000

# Cursor styling + SSH session terminfo
# (all shell integration options must be passed together
shell-integration-features = no-cursor,ssh-env

# Keyboard bindings
keybind = ctrl+tab=text:\x1b[1;5I
keybind = ctrl+shift+tab=text:\x1b[1;6I
keybind = shift+insert=paste_from_clipboard
keybind = control+insert=copy_to_clipboard

# Slowdown mouse scrolling
mouse-scroll-multiplier = 0.95

# Fix general slowness on hyprland (https://github.com/ghostty-org/ghostty/discussions/3224)
async-backend = epoll
