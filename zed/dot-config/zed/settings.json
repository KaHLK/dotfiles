// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
	// UI
  "git": {
  "inline_blame": {
   "show_commit_summary": true,
   "enabled": true
  }
 },
 "edit_predictions": {
  "provider": "none"
 },
 "theme": "Xcode Midnight",
	"icon_theme": "Bearded Icon Fork",
	"buffer_font_family": "FiraCode Nerd Font Mono",
	"buffer_font_size": 12,
	"buffer_line_height": "comfortable",
	"buffer_font_features": {
		"calt": true
	},
	"ui_font_size": 15,
	"ui_font_features": {
		"calt": true
	},
	"project_panel": {
		"folder_icons": false
	},
	"collaboration_panel": {
		"button": true
	},
	"outline_panel": {
		"button": false,
		"folder_icons": false
	},
	"agent": {
		"button": false
	},
	"tabs": {
		"git_status": true,
		"file_icons": true
	},
	"terminal": {
		"button": false
	},
	// Editor
	"vim_mode": true,
	"vim": {
		"toggle_relative_line_numbers": true
	},
	"active_pane_modifiers": {
		"border_size": 1
	},
	"pane_split_direction_horizontal": "down",
	"pane_split_direction_vertical": "right",
	"centered_layout": {
		"left_padding": 0.2,
		"right_padding": 0.2
	},
	"tab_size": 4,
	"show_whitespaces": "boundary",
	"show_wrap_guides": true,
	"soft_wrap": "bounded",
	"preferred_line_length": 100,
	"indent_guides": {
		"coloring": "indent_aware",
		"background_coloring": "indent_aware"
	},
	"always_treat_brackets_as_autoclosed": true,
	"minimap": {
		"show": "always",
		"display_in": "all_editors"
	},
	// LSP
	"formatter": "language_server",
	"use_on_type_format": false,
	"lsp": {
		"rust-analyzer": {
			"initialization_options": {
				"check": {
					"command": "clippy"
				}
			}
		},
		"biome": {
			"settings": {
				"require_config_file": true
			}
		}
	},
	"code_actions_on_format": {
		"fixAll": true
	},
	"prettier": {
		"allowed": false
	},
	"languages": {
		"Rust": {
			"inlay_hints": {
				"enabled": true
			}
		},
		"JavaScript": {
			"language_servers": ["typescript-language-server", "!vtsls","!eslint", "!tailwindcss-language-server",  "..."],
			"formatter": {
				"language_server": {
					"name": "biome"
				}
			},
			"code_actions_on_format": {
				"source.fixAll.biome": true,
				"source.organizeImports.biome": true
			}
		},
		"TypeScript": {
			"language_servers": ["typescript-language-server","!vtsls","!eslint", "!tailwindcss-language-server",  "..."],
			"formatter": {
				"language_server": {
					"name": "biome"
				}
			},
			"code_actions_on_format": {
				"source.fixAll.biome": true,
				"source.organizeImports.biome": true
			}
		},
		"TSX": {
			"language_servers": ["typescript-language-server", "!vtsls","!eslint", "!tailwindcss-language-server",  "..."],
			"formatter": {
				"language_server": {
					"name": "biome"
				}
			},
			"code_actions_on_format": {
				"source.fixAll.biome": true,
				"source.organizeImports.biome": true
			}
		},
		"JSON": {
			"formatter": {
				"language_server": {
					"name": "biome"
				}
			}
		},
		"JSONC": {
			"formatter": {
				"language_server": {
					"name": "biome"
				}
			}
		},
		"CSS": {
			"formatter": {
				"language_server": {
					"name": "biome"
				}
			}
		}
	},
	"telemetry": {
		"diagnostics": false,
		"metrics": false
	},
	"file_types": {
		"XML": ["svg"]
	}
}
