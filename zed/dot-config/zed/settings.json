// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
    // UI
    "cli_default_open_behavior": "new_window",
    "git_panel": {
        "dock": "left"
    },
    "theme": "Xcode Midnight",
    "icon_theme": "Bearded Icons",
    "buffer_font_family": "FiraCode Nerd Font Mono",
    "buffer_font_size": 12,
    "buffer_line_height": "comfortable",
    "buffer_font_features": {
        "calt": true
    },
    "ui_font_size": 15,
    "ui_font_features": {
        "calt": true
    },
    "project_panel": {
        "dock": "left",
        "folder_icons": false
    },
    "collaboration_panel": {
        "dock": "left",
        "button": false
    },
    "outline_panel": {
        "dock": "left",
        "button": false,
        "folder_icons": false
    },
    "agent": {
        "dock": "right",
        "button": false
    },
    "tabs": {
        "activate_on_close": "left_neighbour",
        "show_diagnostics": "all",
        "git_status": true,
        "file_icons": true
    },
    "terminal": {
        "button": false
    },

    // Editor
    "vim_mode": true,
    "vim": {
        "toggle_relative_line_numbers": true
    },
    "active_pane_modifiers": {
        "border_size": 1
    },
    "pane_split_direction_horizontal": "down",
    "pane_split_direction_vertical": "right",
    "centered_layout": {
        "left_padding": 0.2,
        "right_padding": 0.2
    },
    "tab_size": 4,
    "show_whitespaces": "boundary",
    "show_wrap_guides": true,
    "soft_wrap": "bounded",
    "preferred_line_length": 100,
    "indent_guides": {
        "coloring": "indent_aware",
        "background_coloring": "indent_aware"
    },
    "always_treat_brackets_as_autoclosed": true,
    "minimap": {
        "show": "always",
        "display_in": "all_editors"
    },
    "sticky_scroll": {
        "enabled": true
    },
    "vertical_scroll_margin": 5.0,
    "git": {
        "inline_blame": {
            "enabled": true
        }
    },

    // LSP
    "formatter": "language_server",
    "use_on_type_format": false,
    "lsp": {
        "rust-analyzer": {
            "initialization_options": {
                "check": {
                    "command": "clippy"
                }
            }
        },
        "biome": {
            "settings": {
                "require_config_file": true
            }
        },
        "oxlint": {
            "initialization_options": {
                "settings": {
                    "run": "onType",
                    "unusedDisableDirectives": "warn",
                    "fixKind": "safe_fix"
                }
            }
        },
        "oxfmt": {
            "initialization_options": {
                "settings": {
                    "run": "onSave"
                }
            }
        }
    },
    "format_on_save": "on",
    "code_actions_on_format": {
        "fixAll": true
    },
    "prettier": {
        "allowed": false
    },
    "languages": {
        "Rust": {
            "inlay_hints": {
                "enabled": true
            }
        },
        "JavaScript": {
            "language_servers": [
                "vtsls",
                "!eslint",
                "!tailwindcss-language-server",
                "..."
            ],
            "formatter": {
                "language_server": {
                    "name": "biome"
                }
            },
            "code_actions_on_format": {
                "source.fixAll.biome": true,
                "source.organizeImports.biome": true
            }
        },
        "TypeScript": {
            "language_servers": [
                "vtsls",
                "!eslint",
                "!tailwindcss-language-server",
                "..."
            ],
            "formatter": {
                "language_server": {
                    "name": "biome"
                }
            },
            "code_actions_on_format": {
                "source.fixAll.biome": true,
                "source.organizeImports.biome": true
            }
        },
        "TSX": {
            "language_servers": [
                "vtsls",
                "!eslint",
                "!tailwindcss-language-server",
                "..."
            ],
            "formatter": {
                "language_server": {
                    "name": "biome"
                }
            },
            "code_actions_on_format": {
                "source.fixAll.biome": true,
                "source.organizeImports.biome": true
            }
        },
        "JSON": {
            "formatter": {
                "language_server": {
                    "name": "biome"
                }
            }
        },
        "JSONC": {
            "formatter": {
                "language_server": {
                    "name": "biome"
                }
            }
        },
        "CSS": {
            "formatter": {
                "language_server": {
                    "name": "biome"
                }
            }
        },
        "Markdown": {
            "language_servers": ["!oxfmt", "..."]
        },
        "CSharp": {
            "language_servers": ["omnisharp", "!roslyn", "..."]
        }
    },
    "file_types": {
        "XML": ["svg"]
    },

    // AI/telemetry
    "disable_ai": true,
    "edit_predictions": {
        "provider": "none"
    },
    "telemetry": {
        "diagnostics": false,
        "metrics": false
    }
}
